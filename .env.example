# CodeBank runtime env. Copy to .env on the server; never commit real values.

# Required for the kid chat + progress judge:
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Required for the parent dashboard (/admin):
ADMIN_PASS=REPLACE_ME

# Kid profiles live in env (NOT in the repo) so no names are ever public.
# JSON array; birthYear is optional but lets the AI tune to the child's age.
CODEBANK_KIDS=[{"id":"k1","name":"Coder","birthYear":2017,"avatar":"🦊"}]

# Optional overrides (defaults shown):
# CHAT_MODEL=claude-sonnet-4-6
# JUDGE_MODEL=claude-haiku-4-5-20251001
# DEFAULT_THRESHOLD_MIN=30
# DEFAULT_REWARD_MIN=30
# DEFAULT_DAILY_CAP_MIN=120
# DEFAULT_SNAPSHOT_INTERVAL_MIN=4
# DEFAULT_MIN_SCORE=0.5
# DATA_DIR=/app/data
# TZ=America/New_York
